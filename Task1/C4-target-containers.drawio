<mxfile host="app.diagrams.net"><diagram name="Task1. Целевая архитектура (C4)" id="c4"><mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2420" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Задание 1. Целевая архитектура данных «Будущего 2.0» через год (C4, уровень контейнеров)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2300" height="32" as="geometry"/></mxCell><mxCell id="p1" value='&lt;b&gt;Бизнес-аналитик домена&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Сотрудник]&lt;br&gt;строит отчёты сам&lt;/font&gt;' style="fillColor=#DAE8FC;strokeColor=#6C8EBF;rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value='&lt;b&gt;Сотрудник клиники&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Сотрудник]&lt;br&gt;работа с картами&lt;/font&gt;' style="fillColor=#DAE8FC;strokeColor=#6C8EBF;rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value='&lt;b&gt;DS / ML-инженер&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Сотрудник]&lt;br&gt;обучение моделей&lt;/font&gt;' style="fillColor=#DAE8FC;strokeColor=#6C8EBF;rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1100" width="200" height="90" as="geometry"/></mxCell><mxCell id="x1" value='&lt;b&gt;Фармацевтические партнёры&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Внешняя система]&lt;/font&gt;' style="fillColor=#E8E4F0;strokeColor=#8C8496;rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2140" y="180" width="230" height="80" as="geometry"/></mxCell><mxCell id="x2" value='&lt;b&gt;Производитель медтехники&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Внешняя система]&lt;/font&gt;' style="fillColor=#E8E4F0;strokeColor=#8C8496;rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2140" y="290" width="230" height="80" as="geometry"/></mxCell><mxCell id="x3" value='&lt;b&gt;Регулятор финтеха&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Внешняя система]&lt;/font&gt;' style="fillColor=#E8E4F0;strokeColor=#8C8496;rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2140" y="1100" width="230" height="80" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b&gt;Будущее 2.0: целевой контур (облако)&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="70" width="1800" height="1400" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Витрина данных&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="560" height="250" as="geometry"/></mxCell><mxCell id="n01" value='&lt;b&gt;Портал самообслуживания&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Web]&lt;br&gt;конструктор отчётов&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="360" y="185" width="230" height="90" as="geometry"/></mxCell><mxCell id="n02" value='&lt;b&gt;Semantic-слой&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Контейнер]&lt;br&gt;единые метрики&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="660" y="185" width="200" height="90" as="geometry"/></mxCell><mxCell id="s1" value='&lt;b&gt;С1. Быстрая отчётность&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;минуты вместо часов&lt;/font&gt;' style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F0F9F0;strokeColor=#2E7D32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="360" y="300" width="240" height="50" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Платформа данных (self-service)&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="560" height="430" as="geometry"/></mxCell><mxCell id="n03" value='&lt;b&gt;Обработка данных&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Контейнер]&lt;br&gt;потоки, пакеты, ФЛК&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="360" y="540" width="230" height="90" as="geometry"/></mxCell><mxCell id="n04" value='&lt;b&gt;Lakehouse: S3 + Iceberg&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Контейнер]&lt;br&gt;без медкарт&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="660" y="540" width="200" height="90" as="geometry"/></mxCell><mxCell id="n05" value='&lt;b&gt;Витрины доменов&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Контейнер]&lt;br&gt;data products&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="360" y="700" width="230" height="90" as="geometry"/></mxCell><mxCell id="n06" value='&lt;b&gt;Каталог и Lineage&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Контейнер]&lt;br&gt;DataHub&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="660" y="700" width="200" height="90" as="geometry"/></mxCell><mxCell id="s3" value='&lt;b&gt;С3. Масштабирование&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;новый бизнес без логики в DWH&lt;/font&gt;' style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F0F9F0;strokeColor=#2E7D32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="660" y="810" width="220" height="50" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;Интеграция&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="990" width="560" height="260" as="geometry"/></mxCell><mxCell id="n15" value='&lt;b&gt;API-шлюз&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Kong]&lt;br&gt;контракты партнёров&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="360" y="1060" width="230" height="100" as="geometry"/></mxCell><mxCell id="n16" value='&lt;b&gt;Брокер сообщений&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Kafka]&lt;br&gt;транспорт, retry, DLQ&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="660" y="1060" width="200" height="100" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Домен «Финтех-сервисы»&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="560" height="250" as="geometry"/></mxCell><mxCell id="n07" value='&lt;b&gt;Финтех-сервисы&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Go, Java]&lt;br&gt;логика домена: платежи, кредиты&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#C27100" vertex="1" parent="1"><mxGeometry x="1030" y="185" width="230" height="90" as="geometry"/></mxCell><mxCell id="n08" value='&lt;b&gt;БД финтеха&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[PostgreSQL]&lt;br&gt;своё хранилище&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="1330" y="185" width="200" height="90" as="geometry"/></mxCell><mxCell id="s2" value='&lt;b&gt;С2. Финтех и ИИ отдельно&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;свои среды, релизы без DWH&lt;/font&gt;' style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F0F9F0;strokeColor=#2E7D32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1030" y="300" width="280" height="50" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Домен «Клиники» (медицинские данные, PHI)&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="470" width="560" height="430" as="geometry"/></mxCell><mxCell id="n09" value='&lt;b&gt;Портал сотрудников клиник&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Web]&lt;br&gt;замена PowerBuilder&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="1030" y="540" width="230" height="90" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;Сервис медицинских данных&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Контейнер]&lt;br&gt;карты, логика домена&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="1330" y="540" width="200" height="90" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;Операционная БД клиник&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[PostgreSQL]&lt;br&gt;визиты, расписание&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="1030" y="700" width="230" height="90" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;Витрина операций клиник&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Контейнер]&lt;br&gt;визиты и загрузка, без карт&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="1330" y="700" width="200" height="90" as="geometry"/></mxCell><mxCell id="nopr" value="&lt;b&gt;Содержание карт в аналитику не идёт&lt;/b&gt;" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#C00000;align=left;" vertex="1" parent="1"><mxGeometry x="1030" y="820" width="250" height="30" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;Домен «ИИ-сервисы»&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="990" width="560" height="260" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;ML-платформа&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Python]&lt;br&gt;обучение моделей&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#C27100" vertex="1" parent="1"><mxGeometry x="1030" y="1060" width="230" height="100" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;Feature Store&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Контейнер]&lt;br&gt;признаки моделей&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#2E7D32" vertex="1" parent="1"><mxGeometry x="1330" y="1060" width="200" height="100" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;Легаси on-premise (выводится)&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1680" y="130" width="240" height="500" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;DWH SQL Server 2008&lt;/b&gt;" style="fillColor=#F5F5F5;strokeColor=#999999;dashed=1;rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1705" y="185" width="190" height="70" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;ESB Apache Camel&lt;/b&gt;" style="fillColor=#F5F5F5;strokeColor=#999999;dashed=1;rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1705" y="280" width="190" height="70" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;PowerBuilder&lt;/b&gt;" style="fillColor=#F5F5F5;strokeColor=#999999;dashed=1;rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1705" y="375" width="190" height="70" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;Power BI поверх DWH&lt;/b&gt;" style="fillColor=#F5F5F5;strokeColor=#999999;dashed=1;rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1705" y="470" width="190" height="70" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;Зелёный блок - новый контейнер. Оранжевый блок - существующий, доработанный. Серый пунктирный блок - легаси, выводится. Сплошная серая стрелка - поток данных. Зелёный пунктир - управляющая связь каталога. Оранжевый пунктир - перенос из легаси: данные DWH и функции ESB. Красный пунктир - запрещённый поток (не существует)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="40" y="1510" width="1100" height="90" as="geometry"/></mxCell><mxCell id="goal" value="&lt;b&gt;Медицинские карты, истории болезней и результаты исследований в аналитику не идут.&lt;/b&gt; Обезличивание оставляет медицинское содержание, поэтому из сервиса медкарт нет потока в витрину и в lakehouse. В витрину клиник попадают визиты и загру