<mxfile host="app.diagrams.net"><diagram name="Task2. DFD домены и потоки" id="dfd"><mxGraphModel dx="2300" dy="1400" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2420" pageHeight="1620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Задание 2. Потоки данных между доменами «Будущего 2.0» (DFD)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2200" height="32" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;Сотрудник клиники&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="190" height="70" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;Клиент финтех-сервисов&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="190" height="70" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b&gt;Бизнес-аналитик домена&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="190" height="70" as="geometry"/></mxCell><mxCell id="e4" value="&lt;b&gt;Фармацевтический партнёр&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2140" y="180" width="220" height="70" as="geometry"/></mxCell><mxCell id="e5" value="&lt;b&gt;Производитель электроники&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2140" y="280" width="220" height="70" as="geometry"/></mxCell><mxCell id="e6" value="&lt;b&gt;Регулятор финтеха&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2140" y="430" width="220" height="70" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;Домен «Клиники» (PHI)&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="120" width="540" height="400" as="geometry"/></mxCell><mxCell id="p11" value="&lt;b&gt;1.1 Вести карты и визиты&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="180" width="220" height="90" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;D1&lt;/b&gt; Медкарты, истории,&lt;br&gt;результаты исследований&lt;br&gt;&lt;font color="#C00000"&gt;&lt;b&gt;только домен клиник&lt;/b&gt;&lt;/font&gt;' style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="170" width="200" height="110" as="geometry"/></mxCell><mxCell id="p12" value="&lt;b&gt;1.2 Считать загрузку клиник&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="340" width="220" height="100" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;Домен «Финтех-сервисы»&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="560" height="400" as="geometry"/></mxCell><mxCell id="p21" value="&lt;b&gt;2.1 Проводить платежи и кредиты&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="180" width="230" height="90" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;D2&lt;/b&gt; Операции финтеха" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="180" width="200" height="70" as="geometry"/></mxCell><mxCell id="p22" value="&lt;b&gt;2.2 Формировать отчётность&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="340" width="230" height="90" as="geometry"/></mxCell><mxCell id="p23" value="&lt;b&gt;2.3 Публиковать дата-продукт&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="320" width="200" height="110" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;Домен «Партнёры»&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1620" y="120" width="360" height="300" as="geometry"/></mxCell><mxCell id="p51" value="&lt;b&gt;5.1 Принимать данные по контрактам&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="180" width="300" height="90" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;D3&lt;/b&gt; Данные партнёров" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="310" width="300" height="60" as="geometry"/></mxCell><mxCell id="f6" value="&lt;b&gt;Витрина данных&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="710" width="250" height="220" as="geometry"/></mxCell><mxCell id="p61" value="&lt;b&gt;6.1 Строить отчёты&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="305" y="780" width="200" height="90" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;Платформа данных (общая служба)&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="690" width="960" height="420" as="geometry"/></mxCell><mxCell id="p31" value="&lt;b&gt;3.1 Принимать изменения (CDC)&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="760" width="240" height="90" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;D4&lt;/b&gt; Lakehouse: S3 + Iceberg" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="760" width="230" height="80" as="geometry"/></mxCell><mxCell id="p33" value="&lt;b&gt;3.3 Вести каталог&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="760" width="240" height="90" as="geometry"/></mxCell><mxCell id="p32" value="&lt;b&gt;3.2 Собирать витрины&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="930" width="190" height="90" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;D5&lt;/b&gt; Витрина финтеха" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="940" width="170" height="70" as="geometry"/></mxCell><mxCell id="d6" value="&lt;b&gt;D6&lt;/b&gt; Загрузка клиник,&lt;br&gt;без содержания карт" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="930" width="180" height="80" as="geometry"/></mxCell><mxCell id="d8" value="&lt;b&gt;D8&lt;/b&gt; Витрина партнёров" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="940" width="170" height="70" as="geometry"/></mxCell><mxCell id="f5" value="&lt;b&gt;Домен «ИИ-сервисы»&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1620" y="690" width="360" height="360" as="geometry"/></mxCell><mxCell id="p41" value="&lt;b&gt;4.1 Обучать модели&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="760" width="300" height="80" as="geometry"/></mxCell><mxCell id="d7" value="&lt;b&gt;D7&lt;/b&gt; Версии моделей" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="880" width="300" height="55" as="geometry"/></mxCell><mxCell id="p42" value="&lt;b&gt;4.2 Диагностика&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="970" width="300" height="60" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Сценарий «ИИ для анализа медданных»&lt;/b&gt;: карта остаётся в D1, в D6 только загрузка клиник" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F0F9F0;strokeColor=#2E7D32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="280" y="1390" width="560" height="50" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Сценарий «Новый финтех-сервис»&lt;/b&gt;: события в 3.1, витрина через 2.3, DWH не трогается" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F0F9F0;strokeColor=#2E7D32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="870" y="1390" width="560" height="50" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Сценарий «Подключение фармы»&lt;/b&gt;: контракт с 5.1, витрина D8, ядро не меняется" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F0F9F0;strokeColor=#2E7D32;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1460" y="1390" width="520" height="50" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;Прямоугольник - внешний субъект. Жёлтый блок - процесс домена. Зелёный блок - процесс платформы или витрины. Открытая полоса - хранилище данных. Сплошная стрелка - поток данных. Зелёный пунктир - управляющая связь каталога. Красный пунктир - запрещённый поток (не существует). Сущности и хранилища обмениваются только через процессы." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="280" y="1470" width="1100" height="90" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Медкарты, истории болезней и результаты исследований в lakehouse и в D6 не переносятся.&lt;/b&gt; Обезличивание не снимает запрет. В аналитику уходит загрузка клиник, не содержание карт." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#FDECEA;strokeColor=#C00000;" vertex="1" parent="1"><mxGeometry x="1420" y="1470" width="940" height="90" as="geometry"/></mxCell><mxCell id="f01" value="операции" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.3;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="e1" target="p11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f02" value="платежи" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.3;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="e2" target="p21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="395"/><mxPoint x="240" y="80"/><mxPoint x="900" y="80"/><mxPoint x="900" y="225"/></Array></mxGeometry></mxCell><mxCell id="f03" value="отчёты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.3;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="e3" target="p61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f04" value="контракт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.3;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="e4" target="p51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f05" value="телеметрия" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.3;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="e5" target="p51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2040" y="315"/><mxPoint x="2040" y="225"/></Array></mxGeometry></mxCell><mxCell id="f06" value="отчёты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.3;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p22" target="e6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1085" y="505"/><mxPoint x="2040" y="505"/><mxPoint x="2040" y="465"/></Array></mxGeometry></mxCell><mxCell id="f07" value="записи" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.3;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p11" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f08" value="чтение карт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.3;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="p11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="155"/><mxPoint x="420" y="155"/></Array></mxGeometry></mxCell><mxCell id="f08b" value="визиты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.3;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p11" target="p12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f09" value="загрузка клиник" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.3;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p12" target="p31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="545"/><mxPoint x="750" y="545"/></Array></mxGeometry></mxCell><mxCell id="fbad" value="PHI не передаётся" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=