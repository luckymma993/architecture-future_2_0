<mxfile host="app.diagrams.net"><diagram name="Task3. Роадмап" id="gantt"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1760" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gt" value="&lt;b&gt;Задание 3. Роадмап перехода к целевой архитектуре данных (год)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1560" height="30" as="geometry"/></mxCell><mxCell id="c_Q1" value="&lt;b&gt;Q1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="340" height="30" as="geometry"/></mxCell><mxCell id="c_Q2" value="&lt;b&gt;Q2&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="70" width="340" height="30" as="geometry"/></mxCell><mxCell id="c_Q3" value="&lt;b&gt;Q3&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="70" width="340" height="30" as="geometry"/></mxCell><mxCell id="c_Q4" value="&lt;b&gt;Q4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="70" width="340" height="30" as="geometry"/></mxCell><mxCell id="r_e0" value='&lt;b&gt;Этап 0. Фундамент&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Облако и сеть, lakehouse, каталог, команда платформы&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="250" height="90" as="geometry"/></mxCell><mxCell id="b_e0" value="" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#588157;strokeColor=none;opacity=70;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="240" height="40" as="geometry"/></mxCell><mxCell id="r_e1" value='&lt;b&gt;Этап 1. Домен финтеха&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Своя БД, CDC-события, витрина D5, вывод логики из DWH&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="250" height="90" as="geometry"/></mxCell><mxCell id="b_e1" value="" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#457b9d;strokeColor=none;opacity=70;" vertex="1" parent="1"><mxGeometry x="450" y="255" width="490" height="40" as="geometry"/></mxCell><mxCell id="r_e2" value='&lt;b&gt;Этап 2. Домен клиник&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Портал вместо PowerBuilder, изоляция PHI, витрина D6&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="250" height="90" as="geometry"/></mxCell><mxCell id="b_e2" value="" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#457b9d;strokeColor=none;opacity=70;" vertex="1" parent="1"><mxGeometry x="700" y="365" width="570" height="40" as="geometry"/></mxCell><mxCell id="r_e3" value='&lt;b&gt;Этап 3. Портал самообслуживания&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Semantic-слой, права доступа, переезд отчётов с BI&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="250" height="90" as="geometry"/></mxCell><mxCell id="b_e3" value="" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#588157;strokeColor=none;opacity=70;" vertex="1" parent="1"><mxGeometry x="1060" y="475" width="590" height="40" as="geometry"/></mxCell><mxCell id="r_e4" value='&lt;b&gt;Этап 4. Партнёры и ИИ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Контракты 5.1, ML-платформа на витринах, вывод DWH и ESB&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="250" height="90" as="geometry"/></mxCell><mxCell id="b_e4" value="" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#bc6c25;strokeColor=none;opacity=70;" vertex="1" parent="1"><mxGeometry x="1240" y="585" width="460" height="40" as="geometry"/></mxCell><mxCell id="gleg" value="&lt;b&gt;Читается так&lt;/b&gt;: полоса - когда идёт работа над этапом. Состав этапов, результаты, команды и обоснование - в файле 02-roadmap.md. Каждому этапу предшествует решение ADR; движение технологий по кольцам радара - в 01-tech-radar.md." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1560" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>