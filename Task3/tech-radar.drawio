<mxfile host="app.diagrams.net"><diagram name="Task3. Техрадар" id="radar"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1650" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Задание 3. Технический радар «Будущего 2.0» (целевое состояние через год)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1560" height="30" as="geometry"/></mxCell><mxCell id="ring_Hold" value="&lt;b&gt;Hold&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d62828;strokeWidth=2;fontSize=13;fontColor=#d62828;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="220" y="250" width="680" height="680" as="geometry"/></mxCell><mxCell id="ring_Assess" value="&lt;b&gt;Assess&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bc6c25;strokeWidth=2;fontSize=13;fontColor=#bc6c25;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="520" height="520" as="geometry"/></mxCell><mxCell id="ring_Trial" value="&lt;b&gt;Trial&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#457b9d;strokeWidth=2;fontSize=13;fontColor=#457b9d;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="380" y="410" width="360" height="360" as="geometry"/></mxCell><mxCell id="ring_Adopt" value="&lt;b&gt;Adopt&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#588157;strokeWidth=2;fontSize=13;fontColor=#588157;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="490" width="200" height="200" as="geometry"/></mxCell><mxCell id="q1" value="&lt;b&gt;Языки и фреймворки&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="320" height="26" as="geometry"/></mxCell><mxCell id="q2" value="&lt;b&gt;Практики и методы&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="320" height="26" as="geometry"/></mxCell><mxCell id="q3" value="&lt;b&gt;Инструменты&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="1000" width="320" height="26" as="geometry"/></mxCell><mxCell id="q4" value="&lt;b&gt;Платформы&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="1000" width="320" height="26" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="555" width="26" height="26" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="529" y="528" width="26" height="26" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="584" y="540" width="26" height="26" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="597" y="441" width="26" height="26" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="687" y="539" width="26" height="26" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="594" y="599" width="26" height="26" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;12&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="565" y="626" width="26" height="26" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="683" y="627" width="26" height="26" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;8&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="597" y="713" width="26" height="26" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;13&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="625" y="867" width="26" height="26" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;15&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="759" y="789" width="26" height="26" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;9&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="486" y="708" width="26" height="26" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;10&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="436" y="670" width="26" height="26" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;11&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="407" y="615" width="26" height="26" as="geometry"/></mxCell><mxCell id="b16" value="&lt;b&gt;16&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="317" y="770" width="26" height="26" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;14&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#113521;strokeColor=#ffffff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="354" y="347" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;Кольца: Adopt - активно используем в проде; Trial - проверяем на пилотах; Assess - изучаем; Hold - не используем в новом и выводим. Номера - технологии в таблице файла 01-tech-radar.md.&lt;br&gt;К концу года: 1 и 2 остаются в Adopt; 12 - новое, сразу в Adopt; 3 и 6 приходят в Adopt; 8 и 11 доходят до Trial; 13, 14, 15 и 16 уходят в Hold." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1050" y="160" width="520" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>