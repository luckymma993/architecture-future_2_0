<mxfile host="app.diagrams.net"><diagram name="Task4. Автоматизация развёртывания" id="deploy"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Задание 4. Автоматизация развёртывания стендов в Yandex Cloud&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1560" height="30" as="geometry"/></mxCell><mxCell id="tf" value="&lt;b&gt;Terraform (main.tf, variables.tf, outputs.tf, terraform.tfvars)&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="900" height="230" as="geometry"/></mxCell><mxCell id="prov" value='&lt;b&gt;Provider «yandex»&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;доступ к API облака&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="140" width="220" height="90" as="geometry"/></mxCell><mxCell id="net" value='&lt;b&gt;Network + Subnet&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;future20-net, 10.10.10.0/24&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="140" width="230" height="90" as="geometry"/></mxCell><mxCell id="sg" value='&lt;b&gt;Security Group&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;SSH от админов, HTTPS для портала&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="140" width="230" height="90" as="geometry"/></mxCell><mxCell id="res" value="&lt;b&gt;Развёрнуто apply-ом&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="380" width="900" height="300" as="geometry"/></mxCell><mxCell id="disk" value='&lt;b&gt;Disk x 2 (network-hdd)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;оба стенда по 10 ГБ&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="440" width="220" height="100" as="geometry"/></mxCell><mxCell id="vm1" value='&lt;b&gt;VM lakehouse-stand&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;2 vCPU, 4 ГБ, NAT&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="440" width="230" height="100" as="geometry"/></mxCell><mxCell id="vm2" value='&lt;b&gt;VM portal-stand&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;2 vCPU, 4 ГБ, NAT&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="440" width="230" height="100" as="geometry"/></mxCell><mxCell id="data" value='&lt;b&gt;Data-блок: образ ubuntu-2204-lts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;id образа читается у провайдера&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="620" width="220" height="40" as="geometry"/></mxCell><mxCell id="man" value="&lt;b&gt;Вне Terraform (вручную)&lt;/b&gt;" style="fillColor=none;strokeColor=#666666;dashed=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="760" width="900" height="180" as="geometry"/></mxCell><mxCell id="tok" value='&lt;b&gt;Ключ сервисного аккаунта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;путь в terraform.tfvars, в репозиторий идёт плейсхолдер&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="820" width="220" height="90" as="geometry"/></mxCell><mxCell id="dns" value='&lt;b&gt;DNS-записи витрины&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;у регистратора, на NAT-адрес из outputs&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="820" width="230" height="90" as="geometry"/></mxCell><mxCell id="mig" value='&lt;b&gt;Миграция данных из DWH&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;процесс этапа 4 роадмапа, не инфраструктура&lt;/font&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="820" width="230" height="90" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;Зелёное - создаётся и изменяется Terraform. Серый пунктир - действия человека вне кода. Зелёный пунктир - авторизация провайдера ключом сервисного аккаунта, её выполняет человек перед запуском. Сплошные стрелки - зависимости ресурсов в main.tf: диск получает образ, VM подключает диск, подсеть и группу безопасности. Файл состояния terraform.tfstate фиксирует, что создано." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="440" height="240" as="geometry"/></mxCell><mxCell id="steps" value="&lt;b&gt;Порядок запуска&lt;/b&gt;&lt;br&gt;1. подставить путь к ключу и id в terraform.tfvars&lt;br&gt;2. terraform init&lt;br&gt;3. terraform plan -var-file=terraform.tfvars&lt;br&gt;4. terraform apply -var-file=terraform.tfvars&lt;br&gt;5. адреса стендов - в outputs (nat_ips)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1220" y="380" width="420" height="200" as="geometry"/></mxCell><mxCell id="e1" value="создаёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.4;strokeColor=#595959;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="prov" target="net"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="правила в сети" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.4;strokeColor=#595959;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="net" target="sg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="image_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.4;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;entryX=0.5;entryY=1" edge="1" parent="1" source="data" target="disk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="boot_disk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.4;strokeColor=#595959;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="disk" target="vm1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="boot_disk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.4;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;entryX=0.5;entryY=0" edge="1" parent="1" source="disk" target="vm2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="415"/><mxPoint x="1035" y="415"/></Array></mxGeometry></mxCell><mxCell id="e6" value="subnet_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.4;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="net" target="vm1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="security_group_ids" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.4;strokeColor=#595959;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="sg" target="vm2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="авторизация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.4;strokeColor=#595959;jumpStyle=arc;jumpSize=8;dashed=1;strokeColor=#2E7D32;exitX=0;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="tok" target="prov"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="865"/><mxPoint x="230" y="185"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>